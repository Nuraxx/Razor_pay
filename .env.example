# Copy this file to .env and fill in real values. Never commit .env itself.

# From Dashboard > Account & Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard > Account & Settings > Webhooks > (your webhook) > Secret
# This is DIFFERENT from RAZORPAY_KEY_SECRET above. Do not reuse the API secret here.
RAZORPAY_WEBHOOK_SECRET=

# "test" or "live" — used only for logging/labeling in Day 1, both use the same webhook
# payload shape, but keep separate .env files per environment in practice.
RAZORPAY_ENV=test

# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///./data/recovery_agent.db

# App server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Day 11 -- LLM-assisted communication layer (llm/). Valid values: mock |
# anthropic | gemini | ollama.
#   mock      -- runs fully offline, requires no model server or API key.
#                What tests/scripts use by default.
#   ollama    -- local Qwen3 14B via a locally-running Ollama server. No API
#                key, no external network call. Requires Ollama running
#                locally (`ollama serve`) with OLLAMA_MODEL already pulled
#                (`ollama pull qwen3:14b`).
#   gemini    -- real Google Gemini API (remote). Requires GEMINI_API_KEY below.
#                gemini-2.5-flash was Google's documented stable model at the
#                time this project was built, but Google has since started
#                returning HTTP 404 "no longer available to new users" for it
#                on newly-created API keys, redirecting to newer model IDs
#                (e.g. gemini-3.6-flash). Verify what your own key can
#                actually call before relying on the default below.
#   anthropic -- real Anthropic API (remote). Requires ANTHROPIC_API_KEY below.
# Never commit a real key here.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# From https://aistudio.google.com/apikey (Gemini Developer API, free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama provider -- no API key required. OLLAMA_BASE_URL is where
# `ollama serve` listens; OLLAMA_MODEL must already be pulled locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Track-03 -- automatic broken-promise detection (recovery/scheduler.py),
# runs in-process via asyncio, no Celery/Redis. Set to "false" to disable
# entirely (e.g. for a read-only/inspection run); never runs during tests
# regardless of this flag (see recovery/scheduler.py's own docstring).
ENABLE_PROMISE_SWEEP_SCHEDULER=true
PROMISE_SWEEP_INTERVAL_SECONDS=300
