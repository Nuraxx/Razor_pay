# Copy this file to .env and fill in real values. Never commit .env itself.

# From Dashboard > Account & Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard > Account & Settings > Webhooks > (your webhook) > Secret
# This is DIFFERENT from RAZORPAY_KEY_SECRET above. Do not reuse the API secret here.
RAZORPAY_WEBHOOK_SECRET=RazorpayRecoveryWebhook2026RandomSecret

# "test" or "live" — used only for logging/labeling in Day 1, both use the same webhook
# payload shape, but keep separate .env files per environment in practice.
RAZORPAY_ENV=test

# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///./data/recovery_agent.db

# App server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Day 11 -- LLM-assisted communication layer (llm/). "mock" runs fully
# offline with no API key and is what tests/scripts use by default. Only
# set LLM_PROVIDER=anthropic (and fill in a real key below) to use the
# actual Anthropic API instead. Never commit a real key here.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
